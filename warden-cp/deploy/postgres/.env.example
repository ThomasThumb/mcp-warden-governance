# Copy to .env and edit before running docker compose.
POSTGRES_DB=warden_cp
POSTGRES_USER=warden_cp
POSTGRES_PASSWORD=change-this-long-random-password

# Keep the control plane bound to localhost unless it is behind a TLS
# reverse proxy or private network ingress.
WARDEN_CP_BIND=127.0.0.1:7878
# Required because the process binds 0.0.0.0 inside its container. Keep this
# true only while WARDEN_CP_BIND is loopback-only; use TLS for remote ingress.
WARDEN_CP_ALLOW_INSECURE_NON_LOOPBACK=true
TRUST_DOMAIN=warden.local
SIGNING_KEY_PATH=/var/lib/warden-cp/warden-cp-signing.key
ML_DSA_SIGNING_KEY_PATH=/var/lib/warden-cp/warden-cp-ml-dsa65.key

# Local development only. Set this to true before production and configure the
# managed signer variables below. Strict mode refuses to start or create local
# key files unless both Ed25519 and ML-DSA-65 verification keys are available.
WARDEN_REQUIRE_EXTERNAL_SIGNER=false
# WARDEN_SIGNER_COMMAND=/opt/warden/signers/prod-signer
# WARDEN_SIGNER_ARGS_JSON=["--profile","prod"]
# WARDEN_SIGNER_ENV_FROM_JSON={"KMS_KEY_ID":"WARDEN_KMS_KEY_ID"}
# WARDEN_SIGNER_TIMEOUT_MS=5000
# WARDEN_SIGNER_ED25519_PUBLIC_KEY_B64=replace-with-url-safe-base64-without-padding
# WARDEN_SIGNER_ML_DSA65_PUBLIC_KEY_B64=replace-with-url-safe-base64-without-padding

# Optional. Leave blank for CLI-only approval workflows.
APPROVAL_WEBHOOK_URL=

# Optional OIDC/SSO. Keep client secrets in your real secret manager.
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_CLIENT_ID=warden-cp
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URL=https://warden-cp.example.com/oidc/callback
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# OIDC_DEFAULT_ROLES=security_admin
